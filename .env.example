# Environment Variables for Encrypted Chat App
# Copy this file to .env and modify as needed

# WebSocket Server Configuration
PORT=3001
WS_URL=ws://localhost:3001

# For production, you might want to use WSS (secure WebSocket)
# WS_URL=wss://yourdomain.com

# Note: The server's role is ONLY to transport encrypted messages.
# Due to end-to-end encryption, the server cannot decrypt or read message contents.